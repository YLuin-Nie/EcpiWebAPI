<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BobAlexis_MauiClient.MainPage"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Connection Status -->
        <Label x:Name="ConnectionStatusLabel"
               Text="🔌 Connecting to server..."
               TextColor="Gray"
               FontSize="16"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Login Section -->
        <Frame Padding="15" CornerRadius="10" BorderColor="Gray">
            <VerticalStackLayout Spacing="10">
                <Label Text="Login" FontSize="20" FontAttributes="Bold" />
                <Entry x:Name="UsernameEntry" Placeholder="Username" />
                <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
                <Button Text="Login" Clicked="Login_Clicked" BackgroundColor="Blue" TextColor="White" />
                <Label x:Name="LoginStatusLabel" Text="" TextColor="Red" FontSize="14" />
            </VerticalStackLayout>
        </Frame>

        <!-- Message Section -->
        <Frame Padding="15" CornerRadius="10" BorderColor="Gray">
            <VerticalStackLayout Spacing="10">
                <Label Text="Send a Message" FontSize="20" FontAttributes="Bold" />
                <Entry x:Name="UserEntry" Placeholder="Your Name" />
                <Entry x:Name="MessageEntry" Placeholder="Type your message" />
                <Button Text="Send" Clicked="SendMessage_Clicked" BackgroundColor="Green" TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!-- Message Output -->
        <ScrollView HeightRequest="200">
            <VerticalStackLayout x:Name="MessagesStack" />
        </ScrollView>

    </VerticalStackLayout>

</ContentPage>
